{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized portal administrator record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": ["uid", "createdAt"]
    },
    "UserAccountProfile": {
      "title": "UserAccountProfile",
      "description": "Authenticated user account metadata stored privately per user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z0-9_]+$"
        },
        "phone": {
          "type": "string",
          "maxLength": 20
        },
        "gender": {
          "type": "string",
          "enum": ["Male", "Female"]
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 2000
        },
        "provider": {
          "type": "string",
          "maxLength": 40
        },
        "emailVerified": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "lastSignedInAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": ["uid", "email", "fullName", "provider", "emailVerified", "lastSignedInAt"]
    },
    "UsernameLookup": {
      "title": "UsernameLookup",
      "description": "Maps lowercase username handles to email for cross-device username sign-in.",
      "type": "object",
