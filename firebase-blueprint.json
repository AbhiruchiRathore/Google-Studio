        "income": {
          "type": "string",
          "maxLength": 100
        },
        "height": {
          "type": "string",
          "maxLength": 40
        },
        "dob": {
          "type": "string",
          "maxLength": 40
        },
        "birthTime": {
          "type": "string",
          "maxLength": 40
        },
        "familyDetails": {
          "type": "string",
          "maxLength": 2000
        },
        "about": {
          "type": "string",
          "maxLength": 2000
        },
        "photo": {
          "type": "string",
          "maxLength": 350000
        },
        "coverPhoto": {
          "type": "string",
          "maxLength": 350000
        },
        "gallery": {
          "type": "array"
