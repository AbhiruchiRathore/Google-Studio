        "verified": {
          "type": "boolean"
        },
        "createdAtIso": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": ["id", "ownerUid", "ownerId", "name", "age", "gender", "gotra", "city", "education", "profession", "status", "verified", "createdAt", "updatedAt"]
    },
    "ProfilePrivateContact": {
